APP_NAME=Ahtlas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

FRONTEND_URL=localhost:3000
ALLOWED_ORIGINS_FRONTEND=http://localhost:3000
ALLOWED_ORIGINS_BACKEND=http://localhost:8000
ALLOWED_ORIGINS_AUTH_LDAP=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL (conexões core, modules e addons — schemas distintos no mesmo banco)
DB_CONNECTION=core
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ahtlas
DB_USERNAME=ahtlas
DB_PASSWORD=secret

# Oracle — base de RH (conexão hr_oracle)
DB_HR_HOST=
DB_HR_PORT=1521
DB_HR_DATABASE=
DB_HR_SERVICENAME=
DB_HR_USERNAME=
DB_HR_PASSWORD=

# Oracle — base analítica (conexão oracle)
DB_ORACLE_HOST=
DB_ORACLE_PORT=1521
DB_ORACLE_DATABASE=
DB_ORACLE_SERVICENAME=
DB_ORACLE_USERNAME=
DB_ORACLE_PASSWORD=

# SQL Server — bases de MIS e portal (conexões mis_primary, mis_secondary, portal_db)
DB_MIS_PRIMARY_HOST=
DB_MIS_PRIMARY_PORT=1433
DB_MIS_PRIMARY_DATABASE=
DB_MIS_PRIMARY_USERNAME=
DB_MIS_PRIMARY_PASSWORD=
DB_MIS_PRIMARY_TRUST_SERVER_CERTIFICATE=true

DB_MIS_SECONDARY_HOST=
DB_MIS_SECONDARY_PORT=1433
DB_MIS_SECONDARY_DATABASE=
DB_MIS_SECONDARY_USERNAME=
DB_MIS_SECONDARY_PASSWORD=
DB_MIS_SECONDARY_TRUST_SERVER_CERTIFICATE=true

DB_PORTAL_DB_HOST=
DB_PORTAL_DB_PORT=1433
DB_PORTAL_DB_DATABASE=
DB_PORTAL_DB_USERNAME=
DB_PORTAL_DB_PASSWORD=
DB_PORTAL_DB_TRUST_SERVER_CERTIFICATE=true

# MongoDB
DB_MONGO_HOST=127.0.0.1
DB_MONGO_PORT=27017
DB_MONGO_DATABASE=ahtlas
DB_MONGO_USERNAME=
DB_MONGO_PASSWORD=

# Storage de arquivos (disco "nas")
NAS_STORAGE_ROOT=
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PULSE_ENABLED=false

# Provedores de autenticação externos
CORPORATE_IDP_URL=https://idp.example.com/api/v1/login
LDAP_DIRECTORY_URL=http://ldap-gateway.example.com/Servicos.asmx/Validacao

# Serviço de fotos dos colaboradores (a matrícula numérica é concatenada ao final)
AVATAR_SERVICE_URL=https://photos.example.com/api/photo?matricula=

# Assistente virtual (chatbot)
ASSISTANT_AUTH_URL=https://iam.example.com/identity/token
ASSISTANT_API_KEY=
ASSISTANT_API_URL=https://assistant.example.com/v2/assistants/00000000-0000-0000-0000-000000000000/sessions
ASSISTANT_API_VERSION=?version=2021-06-14

# Telegram (envio de mensagens pelo comando telegram:send)
TELEGRAM_BOT_TOKEN=

# Parâmetros da aplicação (config/ahtlas.php) — listas separadas por vírgula
AHTLAS_CEO=usr000001
AHTLAS_ADMINS=usr000002
AHTLAS_USERS_EMAIL_DOMAIN=example.com
AHTLAS_CONTROL_CENTER_CDC_USERS=usr000010,usr000011
AHTLAS_REPORTS_OWNER_MANAGERS_N3=usr000020,usr000021
AHTLAS_REPORTS_OWNER_USERS=usr000030
AHTLAS_REPORTS_DEBUG_USERS=usr000002
AHTLAS_KPI_SOURCES_OWNER_MANAGER_N3=usr000020
AHTLAS_AI_POWER_MAIL_TO=destinatario@example.com
AHTLAS_AI_POWER_MAIL_TO_NAME="Destinatário"
